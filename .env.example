# Required: the n8n Production/Test webhook URL that performs the optimization.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/image-seo

# Optional: sent as a header to n8n so the workflow can reject unknown callers.
# Use with an n8n "Header Auth" credential on the Webhook node.
N8N_WEBHOOK_AUTH_HEADER=x-api-key
N8N_WEBHOOK_AUTH_TOKEN=

# Optional: milliseconds to wait for n8n before giving up (default 240000).
N8N_TIMEOUT_MS=240000
